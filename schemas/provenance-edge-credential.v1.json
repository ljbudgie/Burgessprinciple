{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burgess-principle.vercel.app/schemas/provenance-edge-credential.v1.json",
  "title": "Burgess Provenance Edge Credential v1",
  "description": "A signed Verifiable Credential asserting a directed, typed relationship between two existing Burgess artefacts (findings, challenges, review outcomes, key-events, or claims), each addressed by its sha256 commitment. Edges compose into the Accountability Provenance Graph. Public ledgers and Bitcoin anchors carry only sha256 commitments to the endpoints and to this edge; the asserter's reasoning stays local and is committed by evidenceHash. Every asserted edge carries a named DID controller; machine suggestions are confidence=proposed_unsigned and are not valid as signed edges.",
  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject", "proof"],
  "properties": {
    "@context": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string" },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "BurgessProvenanceEdgeCredential" }
    },
    "issuer": {
      "type": ["object", "string"],
      "properties": {
        "id": { "type": "string", "pattern": "^did:" },
        "name": { "type": "string" }
      }
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "required": ["from", "to", "rel", "asserter", "asserterRole"],
      "properties": {
        "id": { "type": "string" },
        "from": {
          "type": "object",
          "required": ["nodeHash", "nodeType"],
          "properties": {
            "nodeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "nodeType": {
              "type": "string",
              "enum": ["finding", "challenge", "review", "keyevent", "claim"]
            }
          },
          "additionalProperties": true
        },
        "to": {
          "type": "object",
          "required": ["nodeHash", "nodeType"],
          "properties": {
            "nodeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "nodeType": {
              "type": "string",
              "enum": ["finding", "challenge", "review", "keyevent", "claim"]
            }
          },
          "additionalProperties": true
        },
        "rel": {
          "type": "string",
          "enum": [
            "supersedes",
            "challenges",
            "resolves",
            "relies_on",
            "escalates",
            "same_decision_maker",
            "same_institution",
            "same_template",
            "same_pattern",
            "recurs_within"
          ]
        },
        "patternTag": {
          "type": "string",
          "enum": [
            "no_named_human",
            "automation_only",
            "template_consideration",
            "no_genuine_consideration",
            "unaccountable_record",
            "evaluator_inversion",
            "procedural_breach"
          ],
          "description": "Required when rel = same_pattern; identifies the shared evasion pattern."
        },
        "evidenceHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Optional commitment to the asserter's private reasoning for the link."
        },
        "asserter": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string", "pattern": "^did:" },
            "name": { "type": "string" }
          },
          "additionalProperties": true
        },
        "asserterRole": {
          "type": "string",
          "enum": ["party", "independent_verifier", "researcher"]
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "confidence": {
          "type": "string",
          "enum": ["asserted", "corroborated", "proposed_unsigned"],
          "description": "proposed_unsigned is reserved for machine suggestions and is invalid on a signed edge."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "rel": { "const": "same_pattern" } }
          },
          "then": { "required": ["patternTag"] }
        }
      ],
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": ["type", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "type": "string" },
        "proofValue": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
