{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burgess-principle.vercel.app/schemas/challenge-credential.v1.json",
  "title": "Burgess Challenge Credential v1",
  "description": "A signed Verifiable Credential contesting a SOVEREIGN or NULL finding. Public ledgers and anchors carry only the sha256 commitment to this VC; the challenger's full statement stays local and is committed by statementHash.",
  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject", "proof"],
  "properties": {
    "@context": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string" },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "BurgessChallengeCredential" }
    },
    "issuer": {
      "type": ["object", "string"],
      "properties": {
        "id": { "type": "string", "pattern": "^did:" },
        "name": { "type": "string" }
      }
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "required": ["challengedFinding", "grounds", "statementHash", "challenger"],
      "properties": {
        "id": { "type": "string" },
        "challengedFinding": {
          "type": "object",
          "required": ["findingId", "vcHash"],
          "properties": {
            "findingId": { "type": "string" },
            "vcHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": true
        },
        "grounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "no_named_human",
              "incomplete_facts",
              "no_genuine_consideration",
              "not_accountable",
              "factual_error",
              "wrong_classification",
              "procedural"
            ]
          }
        },
        "statementHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "challenger": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string", "pattern": "^did:" },
            "name": { "type": "string" }
          },
          "additionalProperties": true
        },
        "requestedRemedy": {
          "type": "string",
          "enum": ["review", "overturn", "amend"]
        },
        "window": {
          "type": "object",
          "properties": {
            "opensAt": { "type": "string", "format": "date-time" },
            "closesAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": ["type", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "type": "string" },
        "proofValue": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
