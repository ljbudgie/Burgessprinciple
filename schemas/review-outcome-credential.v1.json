{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://burgess-principle.vercel.app/schemas/review-outcome-credential.v1.json",
  "title": "Burgess Review Outcome Credential v1",
  "description": "A signed Verifiable Credential recording a named human's resolution of a challenge: UPHELD, OVERTURNED, or AMENDED. Public ledgers and anchors carry only the sha256 commitment to this VC; the reviewer's reasoning stays local and is committed by reasoningHash.",
  "type": "object",
  "required": ["@context", "type", "issuer", "credentialSubject", "proof"],
  "properties": {
    "@context": { "type": "array", "items": { "type": "string" } },
    "id": { "type": "string" },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "contains": { "const": "BurgessReviewOutcomeCredential" }
    },
    "issuer": {
      "type": ["object", "string"],
      "properties": {
        "id": { "type": "string", "pattern": "^did:" },
        "name": { "type": "string" }
      }
    },
    "validFrom": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "required": ["challengeRef", "originalFinding", "outcome", "reasoningHash", "reviewer", "independence"],
      "properties": {
        "id": { "type": "string" },
        "challengeRef": {
          "type": "object",
          "required": ["challengeId", "challengeHash"],
          "properties": {
            "challengeId": { "type": "string" },
            "challengeHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": true
        },
        "originalFinding": {
          "type": "object",
          "required": ["findingId", "vcHash"],
          "properties": {
            "findingId": { "type": "string" },
            "vcHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          },
          "additionalProperties": true
        },
        "outcome": {
          "type": "string",
          "enum": ["UPHELD", "OVERTURNED", "AMENDED"]
        },
        "reasoningHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "reviewer": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string", "pattern": "^did:" },
            "name": { "type": "string" }
          },
          "additionalProperties": true
        },
        "independence": {
          "type": "object",
          "required": ["reviewerIsChallenger"],
          "properties": {
            "reviewerIsChallenger": { "type": "boolean" },
            "reviewerIsIssuer": { "type": "boolean" }
          },
          "additionalProperties": true
        },
        "supersedingFindingId": { "type": "string" },
        "methodology": {
          "type": "object",
          "properties": {
            "fullFacts": { "type": "boolean" },
            "genuineIndividualConsideration": { "type": "boolean" },
            "personalAccountability": { "type": "boolean" },
            "automationOnly": { "type": "boolean" }
          },
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "outcome": { "const": "AMENDED" } }
          },
          "then": { "required": ["supersedingFindingId"] }
        }
      ],
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": ["type", "verificationMethod", "proofPurpose", "proofValue"],
      "properties": {
        "type": { "type": "string" },
        "created": { "type": "string", "format": "date-time" },
        "verificationMethod": { "type": "string" },
        "proofPurpose": { "type": "string" },
        "proofValue": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
